---
import { ClientRouter } from 'astro:transitions';
import AmbientAudio from '../components/ui/AmbientAudio.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title = 'Burbujas de Luz — Lavandería Autoservicio en Sevilla',
  description = 'Lavandería autoservicio en Sevilla. Lava, seca y disfruta con máquinas modernas a tu ritmo. Descubre las tarifas y cómo funciona.',
  canonical = Astro.url.href,
  ogImage = '/og-placeholder.webp',
  ogType = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:site_name"   content="Burbujas de Luz" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="relative min-h-dvh antialiased">
    <slot />
    <!-- SPEC-009 / D-021: audio ambiental opcional, sin autoplay -->
    <AmbientAudio />
  </body>
</html>
