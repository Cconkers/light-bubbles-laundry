---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Burbujas de Luz — Lavandería Autoservicio en Sevilla',
  description = 'Burbujas de Luz, lavandería autoservicio en Sevilla. La fábrica de burbujas donde tu colada se convierte en magia.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="relative min-h-dvh text-slate-900 antialiased">
    <slot />
  </body>
</html>
