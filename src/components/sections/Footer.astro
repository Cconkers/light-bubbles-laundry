---
import { Image } from 'astro:assets';
import logoWebp from '../../assets/brand/logo.webp';
import Icon from '../ui/Icon.astro';
import { site, contact } from '../../data/content';

/**
 * Footer — información práctica y cierre de marca.
 * Superficie clara (--color-background-alt). Sin bg-black (D-005).
 * Logo a 120px de ancho (respeta mínimo de 104px en móvil).
 * Resumen de contacto sin mapa; ancla #contacto vive en Location (SPEC-006).
 * Redes: bloque omitido por falta de datos confirmados.
 */

const year = new Date().getFullYear();
---

<footer
  class="bg-background-alt border-t border-border"
  role="contentinfo"
>
  <div class="mx-auto max-w-[var(--content-max)] px-[var(--gutter)]">

    <!-- Bloque principal -->
    <div class="py-12 grid gap-10 md:grid-cols-2 lg:grid-cols-3">

      <!-- Marca -->
      <div class="flex flex-col gap-4">
        <a
          href="/"
          class="inline-block focus-visible:outline-none focus-visible:shadow-focus rounded-md"
          aria-label="Burbujas de Luz — inicio"
        >
          <Image
            src={logoWebp}
            alt="Burbujas de Luz"
            width={240}
            height={232}
            loading="lazy"
            decoding="async"
            style="width:120px;height:auto;"
          />
        </a>
        <p class="type-small text-text-secondary" style="max-width:28ch;">
          Lavandería autoservicio en Sevilla. Lava, seca y disfruta a tu ritmo.
        </p>
        <a
          href="#sobre-nosotros"
          class="type-small inline-flex min-h-[44px] items-center font-semibold text-primary
                 transition-colors duration-[var(--duration-fast)]
                 hover:text-primary-hover
                 focus-visible:outline-none focus-visible:shadow-focus rounded-sm"
        >
          Sobre nosotros
        </a>
      </div>

      <!-- Información práctica -->
      <div class="flex flex-col gap-4">
        <h2 class="type-label text-text">
          Información
        </h2>
        <ul class="flex flex-col gap-3" role="list">
          <!-- Dirección -->
          <li class="type-small flex items-start gap-2 text-text-secondary">
            <Icon name="map-pin" size={18} class="mt-0.5 shrink-0 text-primary" />
            <span>{contact.address}</span>
          </li>
          <!-- Horario -->
          <li class="type-small flex items-start gap-2 text-text-secondary">
            <Icon name="clock" size={18} class="mt-0.5 shrink-0 text-primary" />
            <span>{contact.hours}</span>
          </li>
        </ul>
      </div>

      <!-- Contacto -->
      <div class="flex flex-col gap-4">
        <h2 class="type-label text-text">
          Contacto
        </h2>
        <ul class="flex flex-col gap-3" role="list">
          <!-- Teléfono -->
          <li>
            <a
              href={`tel:${contact.phone}`}
              class="type-small inline-flex items-center gap-2 text-text-secondary min-h-[44px]
                     transition-colors duration-[var(--duration-fast)]
                     hover:text-primary
                     focus-visible:outline-none focus-visible:shadow-focus rounded-sm"
            >
              <Icon name="phone" size={18} class="text-primary" />
              {contact.phone}
            </a>
          </li>
          <!-- Email -->
          <li>
            <a
              href={`mailto:${contact.email}`}
              class="type-small inline-flex items-center gap-2 text-text-secondary min-h-[44px]
                     transition-colors duration-[var(--duration-fast)]
                     hover:text-primary
                     focus-visible:outline-none focus-visible:shadow-focus rounded-sm"
            >
              <Icon name="mail" size={18} class="text-primary" />
              {contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior -->
    <div
      class="type-small py-6 border-t border-border flex flex-col sm:flex-row
             items-center justify-between gap-3 text-muted"
    >
      <p>
        © {year} {site.name} · {site.tagline} · {site.location}
      </p>
      <nav aria-label="Información legal" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <a
          href="/aviso-legal"
          class="min-h-[44px] inline-flex items-center text-muted
                 transition-colors duration-[var(--duration-fast)]
                 hover:text-primary
                 focus-visible:outline-none focus-visible:shadow-focus rounded-sm"
        >
          Aviso legal
        </a>
        <a
          href="/privacidad"
          class="min-h-[44px] inline-flex items-center text-muted
                 transition-colors duration-[var(--duration-fast)]
                 hover:text-primary
                 focus-visible:outline-none focus-visible:shadow-focus rounded-sm"
        >
          Privacidad
        </a>
      </nav>
    </div>
  </div>
</footer>
