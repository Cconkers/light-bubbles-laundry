---
/**
 * Header fino y transparente.
 * Desktop: nav centrada con estado activo + scroll-spy.
 * Móvil: hamburguesa; mismo scroll-spy en el menú.
 */

const navLinks = [
  { label: 'Inicio',        href: '/',                section: null },
  { label: 'Servicios',     href: '/#servicios',      section: 'servicios' },
  { label: 'Tarifas',       href: '/#tarifas',        section: 'tarifas' },
  { label: 'Cómo funciona', href: '/#como-funciona',  section: 'como-funciona' },
  { label: 'Preguntas',     href: '/#preguntas',      section: 'preguntas' },
  { label: 'Contacto',      href: '/#contacto',       section: 'contacto' },
] as const;
---

<header
  id="site-header"
  class="site-header fixed inset-x-0 top-0 z-50"
  role="banner"
>
  <div
    class="relative mx-auto flex max-w-[var(--content-max)] items-center
           justify-end lg:justify-center
           px-[var(--gutter)] h-12 lg:h-14"
  >
    <nav
      aria-label="Navegación principal"
      class="hidden lg:flex items-center justify-center gap-0.5"
      data-site-nav
    >
      {navLinks.map(({ label, href, section }) => (
        <a
          href={href}
          data-nav-link
          data-nav-href={href}
          data-nav-section={section ?? ''}
          class="nav-link type-small rounded-pill px-3 py-1.5 font-medium text-text
                 transition-colors duration-[var(--duration-fast)]
                 hover:text-primary focus-visible:outline-none focus-visible:shadow-focus"
        >
          {label}
        </a>
      ))}
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden flex items-center justify-center w-11 h-11 rounded-md
             text-text transition-colors duration-[var(--duration-fast)]
             hover:bg-white/50 focus-visible:outline-none focus-visible:shadow-focus"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="22" height="22"
           viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
           stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22"
           viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
           stroke-linecap="round" aria-hidden="true" class="hidden">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden hidden"
    role="dialog"
    aria-label="Menú de navegación"
    aria-modal="true"
  >
    <nav
      class="flex flex-col gap-1 border-t border-border bg-white/95 backdrop-blur-md px-4 py-3"
      aria-label="Navegación móvil"
      data-site-nav
    >
      {navLinks.map(({ label, href, section }) => (
        <a
          href={href}
          data-nav-link
          data-nav-href={href}
          data-nav-section={section ?? ''}
          class="mobile-nav-link type-body rounded-md px-4 py-3 font-medium
                 text-text-secondary transition-colors duration-[var(--duration-fast)]
                 hover:bg-primary-subtle hover:text-primary
                 focus-visible:outline-none focus-visible:shadow-focus"
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--color-surface) 58%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-soft),
      border-color var(--duration-base) var(--ease-soft),
      box-shadow var(--duration-base) var(--ease-soft);
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-xs);
  }

  .nav-link--active {
    color: var(--color-primary);
    box-shadow: inset 0 -2px 0 var(--color-primary);
    border-radius: 0;
  }

  .mobile-nav-link--active {
    color: var(--color-primary);
    background: var(--color-primary-subtle);
    font-weight: 600;
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconMenu = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;

  const onScrollChrome = () => {
    header.classList.toggle('is-scrolled', window.scrollY > 12);
  };
  onScrollChrome();
  window.addEventListener('scroll', onScrollChrome, { passive: true });

  const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

  function openMenu() {
    menu.classList.remove('hidden');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Cerrar menú de navegación');
    iconMenu.classList.add('hidden');
    iconClose.classList.remove('hidden');
    header.classList.add('is-scrolled');
    menu.querySelector<HTMLElement>('a')?.focus();
  }

  function closeMenu() {
    menu.classList.add('hidden');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir menú de navegación');
    iconMenu.classList.remove('hidden');
    iconClose.classList.add('hidden');
    onScrollChrome();
    toggle.focus();
  }

  toggle.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) closeMenu();
  });

  menu.querySelectorAll<HTMLElement>('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches && isOpen()) closeMenu();
  });

  /* ── Scroll-spy: marca el enlace de la sección visible ───────────────── */
  const spyOrder = [
    { href: '/', section: null as string | null },
    { href: '/#servicios', section: 'servicios' },
    { href: '/#tarifas', section: 'tarifas' },
    { href: '/#como-funciona', section: 'como-funciona' },
    { href: '/#preguntas', section: 'preguntas' },
    { href: '/#contacto', section: 'contacto' },
  ];

  function setActiveHref(href: string) {
    document.querySelectorAll<HTMLElement>('[data-nav-link]').forEach((link) => {
      const match = link.dataset.navHref === href;
      const isDesktop = link.classList.contains('nav-link');
      link.classList.toggle(isDesktop ? 'nav-link--active' : 'mobile-nav-link--active', match);
      if (match) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }

  function resolveActiveHref(): string {
    const offset = header.offsetHeight + Math.min(120, window.innerHeight * 0.2);
    const y = window.scrollY + offset;

    if (window.scrollY < 48) return '/';

    let active = '/';
    for (const item of spyOrder) {
      if (!item.section) continue;
      const el = document.getElementById(item.section);
      if (!el) continue;
      const top = el.getBoundingClientRect().top + window.scrollY;
      if (top <= y) active = item.href;
    }
    return active;
  }

  let spyTicking = false;
  const updateSpy = () => {
    setActiveHref(resolveActiveHref());
    spyTicking = false;
  };

  const onScrollSpy = () => {
    if (spyTicking) return;
    spyTicking = true;
    requestAnimationFrame(updateSpy);
  };

  window.addEventListener('scroll', onScrollSpy, { passive: true });
  window.addEventListener('hashchange', updateSpy);
  window.addEventListener('load', updateSpy);
  updateSpy();
</script>
