---
import { Image, getImage } from "astro:assets";
import Button from "../ui/Button.astro";
import Bubbles from "../Bubbles.astro";
import logoWebp from "../../assets/brand/logo.webp";
import bgDesktop from "../../assets/images/background.webp";
import bgMobile from "../../assets/images/background-sm.webp";
import { hero } from "../../data/content";

/**
 * Hero alineado al mockup:
 * - Escena fotográfica full-bleed (art-direction por breakpoint)
 * - Bloque copy + logo en la pared clara (centro-izquierda), no pegado al borde
 * - H1 completo; logo al lado del bloque (no dentro del título)
 * - Sin velo oscuro (D-005)
 */

const desktopBg = await getImage({
  src: bgDesktop,
  widths: [768, 1024, 1280, 1536],
  format: "webp",
});
---

<section
  id="hero"
  class="relative min-h-dvh flex flex-col overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- Fondo fotográfico — Image de astro:assets + art-direction -->
  <div class="hero-bg-wrap absolute inset-0 -z-20" aria-hidden="true">
    <picture class="hero-bg-picture">
      <source
        media="(min-width: 768px)"
        srcset={desktopBg.srcSet.attribute}
        sizes="100vw"
        width={desktopBg.attributes.width}
        height={desktopBg.attributes.height}
      />
      <Image
        src={bgMobile}
        widths={[384, 768]}
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-bg"
      />
    </picture>
  </div>

  <div
    class="absolute inset-0 -z-10 pointer-events-none hero-light-wash"
    aria-hidden="true"
  >
  </div>

  <Bubbles />

  <!-- Grupo copy + logo: anclado a la pared clara (centro-izquierda) -->
  <div class="hero-content">
    <div class="hero-copy">
      <h1 id="hero-heading" class="hero-title">
        <span class="hero-line1">{hero.headline.line1}</span><br />
        <span class="hero-line2a">{hero.headline.line2a}</span>
        <span class="hero-line2b">{hero.headline.line2b}</span>
        <br />
        <span class="hero-line3a">{hero.headline.line3a}</span>
        <br />
        <span class="hero-line3b">{hero.headline.line3b}</span>
      </h1>

      <p class="hero-subheadline">
        {hero.subheadline}
      </p>

      <div class="hero-actions">
        <Button href={hero.ctaPrimary.href} variant="primary">
          {hero.ctaPrimary.label}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </Button>
        <Button href={hero.ctaSecondary.href} variant="secondary">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>

    <div class="hero-brand">
      <a
        href="#tarifas"
        aria-label="Ir a la sección de tarifas"
        class="hero-logo-link"
      >
        <Image
          src={logoWebp}
          alt="Burbujas de Luz"
          loading="eager"
          decoding="sync"
          class="hero-logo"
          width={400}
          height={400}
          sizes="(max-width: 767px) 42vw, (max-width: 1023px) 22vw, 288px"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .hero-bg-wrap {
    overflow: hidden;
    background: var(--gradient-hero);
  }

  .hero-bg-picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /*
   * Art-direction del fondo por breakpoint:
   * móvil → zona clara; tablet+ → lavandería a la derecha.
   */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 22% center;
  }

  /* Lavado en la franja donde vive el copy (pared clara) */
  .hero-light-wash {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-surface) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-surface) 40%, transparent) 28%,
      color-mix(in srgb, var(--color-surface) 18%, transparent) 48%,
      transparent 68%
    );
  }

  /*
   * Bloque único (copy + logo) en la pared clara — no pegado al borde.
   * Desktop: se desplaza hacia el centro-izquierda de la foto.
   */
  .hero-content {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 auto; /* no estirar a 100dvh — evita centrar el copy abajo */
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 1.25rem;
    width: fit-content;
    max-width: min(100%, 22rem);
    margin-inline: clamp(1.25rem, 4vw, 2rem);
    margin-top: calc(5rem + env(safe-area-inset-top, 0px));
    margin-bottom: 2.5rem;
    padding: 0;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 0 1 auto;
    width: fit-content;
    max-width: 100%;
  }

  .hero-brand {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-start;
  }

  .hero-logo-link {
    display: block;
    line-height: 0;
    border-radius: var(--radius-md);
  }

  .hero-logo-link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .hero-logo {
    width: clamp(7.5rem, 42vw, 10rem);
    height: auto;
    filter: drop-shadow(0 0 1px #a019fa) drop-shadow(0 0 1px #a019fa)
      drop-shadow(0 0 6px #a019fa);
  }

  .hero-title {
    margin: 0;
    font-weight: 600;
    line-height: 1.16;
  }

  .hero-line1,
  .hero-line2a,
  .hero-line2b,
  .hero-line3a,
  .hero-line3b {
    font-size: clamp(6rem, 4.3vw, 7rem);
    letter-spacing: var(--tracking-tight);
    text-shadow:
      0 0 3px #ffffff,
      0 0 3px #f7ff77,
      0 0 3px #fff30078;
  }

  .hero-line1 {
    color: #010b69;
  }
  .hero-line2a {
    color: #6700ac;
  }
  .hero-line2b {
    color: #002291;
  }
  .hero-line3a {
    color: #ff7c11;
  }
  .hero-line3b {
    color: #010b69;
  }

  .hero-subheadline {
    font-size: var(--text-body-lg);
    font-weight: 600;
    line-height: var(--leading-body-lg);
    width: auto;
    max-width: 22rem;
    margin: 2.6rem 0;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
  }

  .hero-actions {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .hero-logo {
      width: clamp(30rem, 25vw, 35rem);
    }

    .hero-content {
      z-index: 2;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.25rem;
      max-width: none;
      margin-top: calc(5rem + env(safe-area-inset-top, 0px));
      margin-bottom: 2.5rem;
      padding: 0;
      align-items: center;
      text-align: center;
    }

    .hero-copy {
      align-items: center;
    }
  }

  @media (min-width: 640px) {
    .hero-bg {
      object-position: 40% center;
    }

    .hero-content {
      max-width: min(100%, 36rem);
      margin-inline: clamp(2rem, 8vw, 6rem) auto;
    }

    .hero-logo {
      width: clamp(35rem, 25vw, 40rem);
    }
  }

  /* Tablet+: copy | logo, desplazados a la pared clara */
  @media (min-width: 930px) {
    .hero-bg {
      object-position: 52% center;
    }

    .hero-content {
      flex-direction: row;
      align-items: center;
      gap: clamp(1.25rem, 2.5vw, 2rem);
      max-width: min(100%, 48rem);
      margin-left: clamp(8vw, 14vw, 18vw);
      margin-right: auto;
      margin-top: calc(5.5rem + env(safe-area-inset-top, 0px));
      margin-bottom: 3rem;
    }

    .hero-copy {
      max-width: none;
    }

    .hero-logo {
      width: clamp(25rem, 25vw, 40rem);
    }

    .hero-subheadline {
      max-width: 24rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-bg {
      object-position: 55% center;
    }

    .hero-content {
      max-width: min(100%, 52rem);
      margin-left: clamp(5vw, 10vw, 22vw);
      margin-top: clamp(5rem, 12vh, 7rem);
      margin-bottom: 4rem;
      align-self: flex-start;
    }
  }

  @media (min-width: 1440px) {
    .hero-bg {
      object-position: 50% center;
    }

    .hero-content {
      margin-left: clamp(14vw, 20vw, 26vw);
      max-width: 54rem;
    }

    .hero-logo {
      width: 39rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo {
      filter: drop-shadow(0 0 1px #a019fa);
    }
  }
</style>
