---
import { Image, getImage } from "astro:assets";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Bubbles from "../Bubbles.astro";
import logoWebp from "../../assets/brand/logo.webp";
import bgDesktop from "../../assets/images/background.webp";
import bgMobile from "../../assets/images/background-sm.webp";
import { hero, site, benefits } from "../../data/content";

/**
 * Hero alineado al mockup:
 * - Escena fotográfica full-bleed (astro:assets + art-direction)
 * - Copy izquierdo SIN caja/fondo (transparente)
 * - H1 Nunito multicolor
 * - Logo grande a la derecha + tagline + eslogan manuscrito
 * - Sin velo oscuro (D-005)
 */

const mobileBg = await getImage({
  src: bgMobile,
  width: 768,
  height: 512,
  format: "webp",
  densities: [1, 2],
});

const desktopBg = await getImage({
  src: bgDesktop,
  widths: [768, 1024, 1280, 1536],
  format: "webp",
});

const benefitAccent: Record<string, string> = {
  violet: "text-primary",
  mint: "text-success",
  cyan: "text-secondary",
  pink: "text-accent",
};
---

<section
  id="hero"
  class="relative min-h-dvh flex flex-col overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- Fondo fotográfico: imagen completa, responsive -->
  <div class="hero-bg-wrap absolute inset-0 -z-20" aria-hidden="true">
    <picture class="hero-bg-picture">
      <source
        media="(min-width: 768px)"
        srcset={desktopBg.srcSet.attribute}
        sizes="100vw"
        width={desktopBg.attributes.width}
        height={desktopBg.attributes.height}
      />
      <img
        src={mobileBg.src}
        srcset={mobileBg.srcSet.attribute}
        alt=""
        width={768}
        height={512}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-bg"
      />
    </picture>
  </div>

  <!-- Filtro de backgroudn solo izquierda -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none hero-light-wash"
    aria-hidden="true"
  >
  </div>

  <Bubbles />

  <!-- Contenido principal -->
  <section class="w-full h-screen">
    <article class="hero-title-container">
      <!-- Columna izquierda: copy transparente -->
      <h1 id="hero-heading" class="hero-title">
        <span class="hero-line1">{hero.headline.line1}</span><br />
        <span class="hero-line2a">{hero.headline.line2a}</span>
        <span class="hero-line2b">{hero.headline.line2b}</span>
        <br />
        <span class="hero-line3a">{hero.headline.line3a}</span>
        <br />
        <span class="hero-line3b">{hero.headline.line3b}</span>
      </h1>

      <p class="hero-subheadline">
        {hero.subheadline}
      </p>

      <div class="flex flex-wrap gap-3 sm:gap-4">
        <Button href={hero.ctaPrimary.href} variant="primary">
          {hero.ctaPrimary.label}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </Button>
        <Button href={hero.ctaSecondary.href} variant="secondary">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </article>

    <!-- Columna derecha: logo grande + tagline + eslogan manuscrito -->
    <article class="hero-brand">
      <a
        href="#cta"
        aria-label="Ir a la sección de tarifas"
        class="hero-logo-link"
      >
        <Image
          src={logoWebp}
          alt="Burbujas de Luz"
          loading="eager"
          decoding="sync"
          class="hero-logo"
          aria-label="Ir a la sección de servicios"
          width={400}
          height={400}
        />
      </a>
    </article>
  </section>
</section>

<style>
  /*
   * Fondo entero y responsive:
   * contain = foto completa sin recortar; el wrap rellena bandas si el ratio no coincide.
   */
  .hero-bg-wrap {
    overflow: hidden;
    background: var(--gradient-hero, linear-gradient(160deg, #ffffff 0%, #f8f2ff 40%, #ebfaff 100%));
  }

  .hero-bg-picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    object-position: center center;
  }

  /* Solo un lavado suave a la izquierda para legibilidad del H1 */
  .hero-light-wash {
    background: linear-gradient(
      90deg,
      #ffffffb8 0%,
      #54d7ff36 34%,
      #ffffff08 58%
    );
  }

  .hero-title {
    display: inline-block;
    font-weight: 600;
    line-height: 1.16;
  }

  .hero-logo:hover {
    opacity: 1;
  }

  .hero-logo {
    opacity: 0.7;
    width: 54vw;
    height: auto;

    /* Contorno oscuro muy sutil */
    filter: drop-shadow(0 0 0.6px rgb(26, 26, 46))
      drop-shadow(0 2px 8px rgba(26, 26, 46, 0.993));

    transition:
      transform 200ms ease,
      opacity 200ms ease,
      filter 200ms ease;
  }

  .hero-logo:hover {
    transform: scale(1.05);
    filter: drop-shadow(0 0 0.8px rgba(26, 26, 46, 0.5))
      drop-shadow(0 4px 12px rgba(26, 26, 46, 0.18));
  }

  .hero-slogan {
    font-family: var(--font-script);
    font-size: 2rem;
    line-height: 2.5;
    font-weight: 700;
    color: hsl(234, 58%, 51%);
    text-decoration: underline;
  }

  .hero-title-container {
    position: relative;
    top: 10%;
    left: 60px;
  }

  .hero-tagline {
    font-size: 2rem;
    line-height: 0;
    font-weight: 600;
    color: #010b69;
    font-style: italic;
  }

  .hero-line1,
  .hero-line2a,
  .hero-line2b,
  .hero-line3a,
  .hero-line3b {
    font-size: 4.5vw;
    letter-spacing: -0.025em;

    text-shadow: 0 0 1px rgb(255, 255, 255);

    filter: drop-shadow(0 0 1px rgba(26, 26, 46, 0.521))
      drop-shadow(0 2px 1px rgba(26, 26, 46, 0.418));
    transition:
      transform 200ms ease,
      filter 200ms ease;
  }

  .hero-line1 {
    color: #010b69;
  }
  .hero-line2a {
    color: #6700ac;
  }
  .hero-line2b {
    color: #002291;
  }

  .hero-line3a {
    color: #ff7c11;
  }

  .hero-line3b {
    color: #010b69;
  }

  .hero-subheadline {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.4;
    width: 24rem;
    margin: 2rem 0;
  }

  @media (min-width: 640px) {
    .hero-logo-lg {
      width: min(240px, 42vw);
    }
  }

  @media (min-width: 1024px) {
    .hero-logo-lg {
      /* Ancho estable sobre la pared blanca; no crece hasta las lavadoras */
      width: clamp(280px, 22vw, 340px);
    }

    .hero-brand {
      max-width: 800px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      bottom: 65%;
      left: 25%;
    }
  }

  @media (min-width: 1440px) {
    .hero-logo-lg {
      width: max-content;
    }
  }
</style>
