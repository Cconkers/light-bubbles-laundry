---
import { Image, getImage } from "astro:assets";
import Button from "../ui/Button.astro";
import Bubbles from "../Bubbles.astro";
import logoWebp from "../../assets/brand/logo.webp";
import bgDesktop from "../../assets/images/background.webp";
import bgMobile from "../../assets/images/background-sm.webp";
import { hero } from "../../data/content";

/**
 * Hero alineado al mockup:
 * - Escena fotográfica full-bleed (astro:assets + art-direction)
 * - Flex responsivo: copy + logo (sin offsets vh/vw absolutos)
 * - H1 multicolor + logo acotado con clamp
 * - Sin velo oscuro (D-005)
 */

const desktopBg = await getImage({
  src: bgDesktop,
  widths: [768, 1024, 1280, 1536],
  format: "webp",
});
---

<section
  id="hero"
  class="relative min-h-dvh flex flex-col overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- Fondo fotográfico — Image de astro:assets + art-direction -->
  <div class="hero-bg-wrap absolute inset-0 -z-20" aria-hidden="true">
    <picture class="hero-bg-picture">
      <source
        media="(min-width: 768px)"
        srcset={desktopBg.srcSet.attribute}
        sizes="100vw"
        width={desktopBg.attributes.width}
        height={desktopBg.attributes.height}
      />
      <Image
        src={bgMobile}
        widths={[384, 768]}
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-bg"
      />
    </picture>
  </div>

  <div
    class="absolute inset-0 -z-10 pointer-events-none hero-light-wash"
    aria-hidden="true"
  >
  </div>

  <Bubbles />

  <!-- Copy + logo: flex controla la composición en todos los anchos -->
  <div class="hero-content">
    <div class="hero-copy">
      <h1 id="hero-heading" class="hero-title">
        <span class="hero-line1">{hero.headline.line1}</span><br />
        <span class="hero-line2a">{hero.headline.line2a}</span>
        <span class="hero-line2b">{hero.headline.line2b}</span>
        <br />
        <span class="hero-line3a">{hero.headline.line3a}</span>
        <br />
        <span class="hero-line3b">{hero.headline.line3b}</span>
      </h1>

      <p class="hero-subheadline">
        {hero.subheadline}
      </p>

      <div class="hero-actions">
        <Button href={hero.ctaPrimary.href} variant="primary">
          {hero.ctaPrimary.label}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </Button>
        <Button href={hero.ctaSecondary.href} variant="secondary">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>

    <div class="hero-brand">
      <a
        href="#tarifas"
        aria-label="Ir a la sección de tarifas"
        class="hero-logo-link"
      >
        <Image
          src={logoWebp}
          alt="Burbujas de Luz"
          loading="eager"
          decoding="sync"
          class="hero-logo"
          width={320}
          height={320}
          sizes="(max-width: 767px) 36vw, 176px"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .hero-bg-wrap {
    overflow: hidden;
    background: var(--gradient-hero);
  }

  .hero-bg-picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    /* Prioriza pared clara a la izquierda; lavadoras a la derecha */
    object-position: 70% center;
  }

  .hero-light-wash {
    background: linear-gradient(
      45deg,
      rgba(43, 0, 255, 0.05) 0%,
      rgba(102, 19, 255, 0.2) 50%,
      rgba(204, 0, 255, 0.05) 100%
    );
  }

  /*
   * Una sola composición compacta a la izquierda (zona libre de la foto).
   * No space-between a todo el ancho: evita el hueco vacío + logo gigante a la derecha.
   */
  .hero-content {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
    max-width: 40rem;
    margin-inline: 0 auto;
    min-height: 100dvh;
    padding:
      calc(4rem + env(safe-area-inset-top, 0px))
      clamp(1.25rem, 5vw, 3rem)
      2rem
      clamp(1.25rem, 5vw, 3.5rem);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .hero-brand {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-start;
    width: auto;
  }

  .hero-logo-link {
    display: block;
    line-height: 0;
    border-radius: var(--radius-md);
  }

  .hero-logo-link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .hero-logo {
    width: clamp(6.5rem, 36vw, 9.5rem);
    height: auto;
    filter: drop-shadow(0 0 1px #a019fa) drop-shadow(0 0 1px #a019fa)
      drop-shadow(0 0 6px #a019fa);
  }

  .hero-title {
    margin: 0;
    font-weight: 600;
    line-height: 1.16;
  }

  .hero-line1,
  .hero-line2a,
  .hero-line2b,
  .hero-line3a,
  .hero-line3b {
    font-size: clamp(1.85rem, 8vw, 2.5rem);
    letter-spacing: -0.025em;
    text-shadow:
      0 0 3px #ffffff,
      0 0 3px #f7ff77,
      0 0 3px #fff30078;
  }

  .hero-line1 {
    color: #010b69;
  }
  .hero-line2a {
    color: #6700ac;
  }
  .hero-line2b {
    color: #002291;
  }
  .hero-line3a {
    color: #ff7c11;
  }
  .hero-line3b {
    color: #010b69;
  }

  /* Contraste AA sin “pegatina”: lavado suave, sin borde ni sombra dura */
  .hero-subheadline {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    width: 100%;
    max-width: 22rem;
    margin: 1rem 0 1.25rem;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Tablet+: copy + logo juntos en la mitad izquierda */
  @media (min-width: 768px) {
    .hero-content {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: clamp(1.25rem, 2.5vw, 2rem);
      max-width: min(52rem, 62vw);
      padding-block: calc(4.5rem + env(safe-area-inset-top, 0px)) 2.5rem;
    }

    .hero-copy {
      flex: 1 1 auto;
      max-width: 28rem;
    }

    .hero-brand {
      flex: 0 0 auto;
      align-self: center;
    }

    .hero-logo {
      width: clamp(8.5rem, 12vw, 11.5rem); /* ~136–184px */
    }

    .hero-line1,
    .hero-line2a,
    .hero-line2b,
    .hero-line3a,
    .hero-line3b {
      font-size: clamp(2.1rem, 3.2vw, 3rem);
    }

    .hero-subheadline {
      font-size: 1.0625rem;
      max-width: 24rem;
    }
  }

  @media (min-width: 1280px) {
    .hero-content {
      max-width: min(54rem, 58vw);
      padding-left: clamp(2.5rem, 6vw, 5rem);
    }

    .hero-logo {
      width: 11rem; /* 176px — tope fijo en desktop grande */
    }

    .hero-line1,
    .hero-line2a,
    .hero-line2b,
    .hero-line3a,
    .hero-line3b {
      font-size: clamp(2.4rem, 2.6vw, 3.15rem);
    }
  }
</style>
