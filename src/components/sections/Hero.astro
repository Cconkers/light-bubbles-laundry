---
import Button from '../ui/Button.astro';
import Bubbles from '../Bubbles.astro';
import { hero, site } from '../../data/content';

/**
 * Hero — primera pantalla.
 * Fondo: lavado de color con --gradient-hero y formas orgánicas (D-005).
 * Sin velo oscuro; legibilidad con superficie translúcida clara.
 * H1 y CTA primario visibles sin scroll en móvil.
 */
---

<section
  id="hero"
  class="relative min-h-dvh flex flex-col justify-center overflow-hidden
         pt-[120px] pb-[var(--space-16)] px-[var(--gutter)]"
  aria-labelledby="hero-heading"
>
  <!-- Fondo: gradiente hero (D-005, sin superficies oscuras) -->
  <div
    class="absolute inset-0 -z-10"
    style="background: var(--gradient-hero);"
    aria-hidden="true"
  ></div>

  <!-- Forma orgánica izquierda -->
  <div
    class="absolute -left-24 bottom-0 h-[500px] w-[500px] -z-10 opacity-40"
    style="background: radial-gradient(circle at 60% 60%, #F1E5FF 0%, transparent 70%);
           border-radius: 60% 40% 70% 30% / 50% 60% 40% 50%;"
    aria-hidden="true"
  ></div>

  <!-- Forma orgánica derecha -->
  <div
    class="absolute -right-16 top-1/4 h-[400px] w-[400px] -z-10 opacity-30"
    style="background: radial-gradient(circle at 40% 40%, #D6F5FF 0%, transparent 70%);
           border-radius: 40% 60% 30% 70% / 60% 40% 60% 40%;"
    aria-hidden="true"
  ></div>

  <!-- Burbujas decorativas (fuera de zona de texto) -->
  <Bubbles />

  <!-- Contenido -->
  <div class="relative z-10 mx-auto w-full max-w-[var(--content-max)]">
    <div class="max-w-xl">

      <!-- Etiqueta de contexto -->
      <p
        class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary"
        style="letter-spacing: 0.08em;"
      >
        {site.location} · {site.tagline}
      </p>

      <!-- H1 único de la página -->
      <h1
        id="hero-heading"
        class="mb-6 font-bold text-text leading-tight"
        style="font-size: clamp(2.25rem, 5vw, 3.5rem); letter-spacing: -0.02em; line-height: 1.1;"
      >
        {hero.headline}
      </h1>

      <!-- Subtítulo -->
      <p
        class="mb-8 text-text-secondary"
        style="font-size: 1.125rem; line-height: 1.6; max-width: var(--prose-max);"
      >
        {hero.subheadline}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4">
        <Button href={hero.ctaPrimary.href} variant="primary">
          {hero.ctaPrimary.label}
        </Button>
        <Button href={hero.ctaSecondary.href} variant="secondary">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>
  </div>
</section>
