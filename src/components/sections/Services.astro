---
import Icon from '../ui/Icon.astro';
import { services } from '../../data/content';

/**
 * Services — qué se ofrece.
 * Tarjetas reutilizables con placeholder de contenido (D-010).
 * id="servicios" para ancla del header.
 */

const accentClasses: Record<string, { bg: string; text: string }> = {
  violet: { bg: 'bg-primary-subtle',  text: 'text-primary' },
  cyan:   { bg: 'bg-secondary-subtle',text: 'text-secondary' },
  mint:   { bg: 'bg-success-subtle',  text: 'text-success' },
  orange: { bg: 'bg-warning-subtle',  text: 'text-warning' },
};
---

<section
  id="servicios"
  class="py-[var(--section-gap)] px-[var(--gutter)] bg-background"
  aria-labelledby="services-heading"
>
  <div class="mx-auto max-w-[var(--content-max)]">

    <div class="mb-12 text-center" data-reveal>
      <h2
        id="services-heading"
        class="type-h2 text-text"
      >
        Nuestros servicios
      </h2>
      <p class="type-body-lg mt-3 text-text-secondary mx-auto" style="max-width: 48ch;">
        Todo lo que necesitas para cuidar tu ropa, en un solo lugar.
      </p>
    </div>

    <ul
      class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4"
      role="list"
    >
      {services.map((s, i) => {
        const accent = accentClasses[s.color] ?? accentClasses.violet;
        return (
          <li
            class="flex flex-col gap-4 rounded-card bg-surface border border-border
                   p-6 shadow-sm transition-shadow duration-(--duration-base)
                   hover:shadow-md"
            data-reveal
            data-reveal-delay={String(Math.min(i + 1, 4)) as '1' | '2' | '3' | '4'}
          >
            <!-- Icono con contenedor circular -->
            <div
              class:list={[
                'flex items-center justify-center w-12 h-12 rounded-full self-start',
                accent.bg, accent.text,
              ]}
              aria-hidden="true"
            >
              <Icon name={s.icon} size={24} />
            </div>

            <div>
              <h3 class="mb-2 type-h3 text-text">
                {s.title}
              </h3>
              <p class="type-small text-muted">
                {s.description}
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
