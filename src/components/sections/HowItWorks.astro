---
import { steps } from '../../data/content';

/**
 * How it works — proceso paso a paso.
 * Marcado como <ol>: la secuencia es semántica (SPEC-001).
 * id="como-funciona" para ancla del header.
 * Números en círculos con acento de color distinto por paso.
 * Layout: 1 col → 2×2 (md) → 4 col (lg).
 */

const stepColors: Record<string, { bg: string; text: string }> = {
  violet: { bg: 'bg-primary-subtle',  text: 'text-primary' },
  pink:   { bg: 'bg-accent-subtle',   text: 'text-accent' },
  cyan:   { bg: 'bg-secondary-subtle',text: 'text-secondary' },
  orange: { bg: 'bg-warning-subtle',  text: 'text-warning' },
};
---

<section
  id="como-funciona"
  class="py-[var(--section-gap)] px-[var(--gutter)] bg-background-alt"
  aria-labelledby="how-heading"
>
  <div class="mx-auto max-w-[var(--content-max)]">

    <div class="mb-12 text-center" data-reveal>
      <h2
        id="how-heading"
        class="font-bold text-text"
        style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em;"
      >
        Así de fácil
      </h2>
      <p class="mt-3 text-text-secondary mx-auto" style="max-width: 40ch; font-size: 1.0625rem; line-height: 1.6;">
        Lava, seca y listo en cuatro sencillos pasos.
      </p>
    </div>

    <ol
      class="grid gap-8 md:grid-cols-2 lg:grid-cols-4"
      role="list"
    >
      {steps.map((step, i) => {
        const colors = stepColors[step.color] ?? stepColors.violet;
        return (
          <li
            class="flex flex-col gap-4"
            data-reveal
            data-reveal-delay={String(Math.min(i + 1, 4)) as '1' | '2' | '3' | '4'}
          >
            <!-- Número de paso -->
            <div
              class:list={[
                'flex items-center justify-center w-12 h-12 rounded-full',
                'font-bold text-lg',
                colors.bg, colors.text,
              ]}
              aria-hidden="true"
            >
              {step.number}
            </div>

            <!-- Texto -->
            <div>
              <h3
                class="mb-2 font-semibold text-text"
                style="font-size: 1.125rem; line-height: 1.3;"
              >
                {step.title}
              </h3>
              <p class="text-muted" style="font-size: 0.9375rem; line-height: 1.6;">
                {step.description}
              </p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
