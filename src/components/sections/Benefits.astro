---
import Icon from '../ui/Icon.astro';
import { benefits } from '../../data/content';

/**
 * Benefits — cuatro ventajas con icono y descripción.
 * Responsivo: 1 col → 2 col (md) → 4 col (lg).
 * Iconos decorativos en contenedor circular *-subtle (DESIGN_SYSTEM — Icons).
 */

const accentClasses: Record<string, { bg: string; text: string }> = {
  violet: { bg: 'bg-primary-subtle',  text: 'text-primary' },
  mint:   { bg: 'bg-success-subtle',  text: 'text-success' },
  cyan:   { bg: 'bg-secondary-subtle',text: 'text-secondary' },
  pink:   { bg: 'bg-accent-subtle',   text: 'text-accent' },
};
---

<section
  class="relative py-[var(--section-gap)] px-[var(--gutter)] bg-background-alt"
  aria-labelledby="benefits-heading"
  data-reveal
>
  <div class="mx-auto max-w-[var(--content-max)]">
    <!-- Encabezado de sección -->
    <div class="mb-12 text-center" data-reveal data-reveal-delay="1">
      <h2
        id="benefits-heading"
        class="type-h2 text-text"
      >
        ¿Por qué Burbujas de Luz?
      </h2>
    </div>

    <!-- Cuadrícula de ventajas -->
    <ul
      class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4"
      role="list"
    >
      {benefits.map((b, i) => {
        const accent = accentClasses[b.color] ?? accentClasses.violet;
        return (
          <li
            class="flex flex-col items-center text-center gap-4"
            data-reveal
            data-reveal-delay={String(i + 1) as '1' | '2' | '3' | '4'}
          >
            <!-- Contenedor circular del icono -->
            <div
              class:list={[
                'flex items-center justify-center w-12 h-12 rounded-full',
                accent.bg, accent.text,
              ]}
              aria-hidden="true"
            >
              <Icon name={b.icon} size={24} />
            </div>

            <!-- Texto -->
            <div>
              <h3 class="mb-1 type-h3 text-text">
                {b.title}
              </h3>
              <p class="type-body text-text-secondary">
                {b.description}
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
