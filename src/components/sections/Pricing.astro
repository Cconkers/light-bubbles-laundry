---
import Card from "../ui/Card.astro";
import LaundryBasket from "../ui/LaundryBasket.astro";
import { pricingByCategory, pricingIntro } from "../../data/content";

/**
 * Tarifas — alineado al mockup §3 (SPEC-003).
 * Datos de ejemplo del design board (maqueta); pendientes de confirmación (D-010).
 * Tabs Lavado/Secado con radio + CSS (:has), JS solo para aria/hidden.
 * id="tarifas" para anclas.
 */

const lavado = pricingByCategory.lavado;
const secado = pricingByCategory.secado;
---

<section
  id="tarifas"
  class="pricing-section relative py-[var(--section-gap)] px-[var(--gutter)]"
  aria-labelledby="pricing-heading"
>
  <div
    class="absolute inset-0 -z-10"
    style="background: var(--gradient-wash);"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-[var(--content-max)]">
    <div class="mb-8 text-center" data-reveal>
      <h2
        id="pricing-heading"
        class="font-bold"
        style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.2;"
      >
        <span class="text-text">{pricingIntro.titleLead}</span>{" "}
        <span class="pricing-title-accent">{pricingIntro.titleAccent}</span>
      </h2>
      <p
        class="mt-3 text-text-secondary mx-auto"
        style="max-width: 48ch; font-size: 1.0625rem; line-height: 1.6;"
      >
        {pricingIntro.subtitle}
      </p>
    </div>

    <div class="pricing-tabs mb-10 flex justify-center" data-reveal>
      <div
        class="inline-flex rounded-pill bg-surface p-1 shadow-sm border border-border"
        role="tablist"
        aria-label="Tipo de tarifa"
      >
        <input
          type="radio"
          name="pricing-category"
          id="pricing-tab-lavado"
          class="pricing-radio"
          checked
        />
        <label
          for="pricing-tab-lavado"
          class="pricing-tab-label"
          id="label-lavado"
        >
          Lavado
        </label>

        <input
          type="radio"
          name="pricing-category"
          id="pricing-tab-secado"
          class="pricing-radio"
        />
        <label
          for="pricing-tab-secado"
          class="pricing-tab-label"
          id="label-secado"
        >
          Secado
        </label>
      </div>
    </div>

    <ul
      id="pricing-panel-lavado"
      class="pricing-panel pricing-panel--lavado grid gap-8 pt-5 sm:grid-cols-2 lg:grid-cols-4 sm:gap-6"
      role="list"
      aria-labelledby="label-lavado"
    >
      {
        lavado.map((plan, i) => {
          return (
            <li
              data-reveal
              data-reveal-delay={
                String(Math.min(i + 1, 4)) as "1" | "2" | "3" | "4"
              }
            >
              <Card
                variant={plan.featured ? "featured" : "plain"}
                class="pricing-card relative flex h-full flex-col items-center gap-3 p-6 pt-8 text-center"
              >
                {"badge" in plan && plan.badge && (
                  <span class="pricing-badge absolute left-1/2 -translate-x-1/2 whitespace-nowrap
                               rounded-pill bg-primary text-xs font-semibold text-text-on-fill shadow-xs">
                    {plan.badge}
                  </span>
                )}

                <p class="text-sm font-semibold text-text-secondary">
                  {plan.title}
                </p>

                <p
                  class="font-bold text-text"
                  style="font-size: clamp(1.5rem, 3vw, 1.875rem); line-height: 1.1; letter-spacing: -0.02em;"
                >
                  {plan.capacity}
                </p>

                <div class="flex items-center justify-center" aria-hidden="true">
                  <LaundryBasket
                    size={Math.max(plan.iconSize + 24, 72)}
                    tone={plan.color as 'violet' | 'pink' | 'cyan' | 'orange' | 'mint'}
                  />
                </div>

                <p
                  class="font-bold text-text"
                  style="font-size: clamp(1.75rem, 3vw, 2.25rem); line-height: 1.1; letter-spacing: -0.02em;"
                >
                  {plan.price}
                </p>

                <p
                  class="text-muted flex-1"
                  style="font-size: 0.9375rem; line-height: 1.5;"
                >
                  {plan.description}
                </p>

                <a
                  href="#como-funciona"
                  class="mt-1 inline-flex min-h-[44px] items-center gap-1 text-sm font-semibold text-primary
                         transition-colors duration-[var(--duration-fast)]
                         hover:text-primary-hover
                         focus-visible:outline-none focus-visible:shadow-focus rounded-md px-1"
                >
                  Ver detalle
                  <span aria-hidden="true">→</span>
                </a>
              </Card>
            </li>
          );
        })
      }
    </ul>

    <ul
      id="pricing-panel-secado"
      class="pricing-panel pricing-panel--secado grid gap-8 pt-5 sm:grid-cols-2 lg:grid-cols-4 sm:gap-6"
      role="list"
      aria-labelledby="label-secado"
      hidden
    >
      {
        secado.map((plan, i) => {
          return (
            <li
              data-reveal
              data-reveal-delay={
                String(Math.min(i + 1, 4)) as "1" | "2" | "3" | "4"
              }
            >
              <Card
                variant={plan.featured ? "featured" : "plain"}
                class="pricing-card relative flex h-full flex-col items-center gap-3 p-6 pt-8 text-center"
              >
                {"badge" in plan && plan.badge && (
                  <span class="pricing-badge absolute left-1/2 -translate-x-1/2 whitespace-nowrap
                               rounded-pill bg-primary text-xs font-semibold text-text-on-fill shadow-xs">
                    {plan.badge}
                  </span>
                )}

                <p class="text-sm font-semibold text-text-secondary">
                  {plan.title}
                </p>

                <p
                  class="font-bold text-text"
                  style="font-size: clamp(1.5rem, 3vw, 1.875rem); line-height: 1.1; letter-spacing: -0.02em;"
                >
                  {plan.capacity}
                </p>

                <div class="flex items-center justify-center" aria-hidden="true">
                  <LaundryBasket
                    size={Math.max(plan.iconSize + 24, 72)}
                    tone={plan.color as 'violet' | 'pink' | 'cyan' | 'orange' | 'mint'}
                  />
                </div>

                <p
                  class="font-bold text-text"
                  style="font-size: clamp(1.75rem, 3vw, 2.25rem); line-height: 1.1; letter-spacing: -0.02em;"
                >
                  {plan.price}
                </p>

                <p
                  class="text-muted flex-1"
                  style="font-size: 0.9375rem; line-height: 1.5;"
                >
                  {plan.description}
                </p>

                <a
                  href="#como-funciona"
                  class="mt-1 inline-flex min-h-[44px] items-center gap-1 text-sm font-semibold text-primary
                         transition-colors duration-[var(--duration-fast)]
                         hover:text-primary-hover
                         focus-visible:outline-none focus-visible:shadow-focus rounded-md px-1"
                >
                  Ver detalle
                  <span aria-hidden="true">→</span>
                </a>
              </Card>
            </li>
          );
        })
      }
    </ul>

    <p
      class="mt-8 text-center text-muted"
      style="font-size: 0.8125rem; line-height: 1.5;"
      data-reveal
    >
      {pricingIntro.note}
    </p>
  </div>
</section>

<style>
  .pricing-section {
    /* No clip del badge “Más popular” que sobresale de la card */
    overflow: visible;
  }

  .pricing-title-accent {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pricing-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pricing-tab-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-soft),
      color var(--duration-fast) var(--ease-soft);
  }

  .pricing-tab-label:hover {
    color: var(--color-primary);
  }

  #pricing-tab-lavado:checked + .pricing-tab-label,
  #pricing-tab-secado:checked + .pricing-tab-label {
    background: var(--color-primary);
    color: var(--color-text-on-fill);
  }

  .pricing-tab-label:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .pricing-section:has(#pricing-tab-lavado:checked) .pricing-panel--lavado {
    display: grid;
  }
  .pricing-section:has(#pricing-tab-lavado:checked) .pricing-panel--secado {
    display: none !important;
  }
  .pricing-section:has(#pricing-tab-secado:checked) .pricing-panel--secado {
    display: grid !important;
  }
  .pricing-section:has(#pricing-tab-secado:checked) .pricing-panel--lavado {
    display: none;
  }

  .pricing-badge {
    top: -25px;
    padding: 0.8rem 2rem;
  }
</style>

<script>
  const lavadoTab = document.getElementById(
    "pricing-tab-lavado",
  ) as HTMLInputElement | null;
  const secadoTab = document.getElementById(
    "pricing-tab-secado",
  ) as HTMLInputElement | null;
  const panelLavado = document.getElementById("pricing-panel-lavado");
  const panelSecado = document.getElementById("pricing-panel-secado");

  function syncPanels() {
    const isLavado = lavadoTab?.checked ?? true;
    panelLavado?.toggleAttribute("hidden", !isLavado);
    panelSecado?.toggleAttribute("hidden", isLavado);
  }

  lavadoTab?.addEventListener("change", syncPanels);
  secadoTab?.addEventListener("change", syncPanels);
  syncPanels();
</script>
