---
import Card from "../ui/Card.astro";
import LaundryBasket from "../ui/LaundryBasket.astro";
import Bubbles from "../Bubbles.astro";
import { pricingByCategory, pricingIntro } from "../../data/content";

/**
 * Tarifas — SPEC-003 + atmósfera SPEC-004 / D-022.
 * Cards: layout compacto SPEC-003 (sin pase de “aire” / precio 64px).
 * id="tarifas" para anclas.
 */

const lavado = pricingByCategory.lavado;
const secado = pricingByCategory.secado;
---

<section
  id="tarifas"
  class="pricing-section min-h-dvh relative py-[var(--section-gap)] px-[var(--gutter)]"
  aria-labelledby="pricing-heading"
>
  <!-- Atmósfera SPEC-004 / D-022: wash + blobs + burbujas suaves -->
  <div class="pricing-atmosphere" aria-hidden="true">
    <div class="pricing-atmosphere__wash"></div>
    <div class="pricing-atmosphere__blob pricing-atmosphere__blob--tl"></div>
    <div class="pricing-atmosphere__blob pricing-atmosphere__blob--br"></div>
    <div class="pricing-atmosphere__blob pricing-atmosphere__blob--tr"></div>
    <div class="pricing-atmosphere__bubbles">
      <Bubbles />
    </div>
  </div>

  <div class="relative z-0 mx-auto max-w-[var(--content-max)]">
    <div class="mb-8 text-center" data-reveal>
      <h2
        id="pricing-heading"
        class="type-h2"
      >
        <span class="text-text">{pricingIntro.titleLead}</span>{" "}
        <span class="pricing-title-accent">{pricingIntro.titleAccent}</span>
      </h2>
      <p
        class="type-body-lg mt-3 text-text-secondary mx-auto"
        style="max-width: 48ch;"
      >
        {pricingIntro.subtitle}
      </p>
    </div>

    <div class="pricing-tabs mb-10 flex justify-center" data-reveal>
      <div
        class="inline-flex rounded-pill bg-surface p-1 shadow-sm border border-border"
        role="radiogroup"
        aria-label="Tipo de tarifa"
      >
        <input
          type="radio"
          name="pricing-category"
          id="pricing-tab-lavado"
          class="pricing-radio"
          checked
        />
        <label
          for="pricing-tab-lavado"
          class="pricing-tab-label"
          id="label-lavado"
        >
          Lavado
        </label>

        <input
          type="radio"
          name="pricing-category"
          id="pricing-tab-secado"
          class="pricing-radio"
        />
        <label
          for="pricing-tab-secado"
          class="pricing-tab-label"
          id="label-secado"
        >
          Secado
        </label>
      </div>
    </div>

    <ul
      id="pricing-panel-lavado"
      class="pricing-panel pricing-panel--lavado grid gap-8 pt-5 sm:grid-cols-2 lg:grid-cols-4 sm:gap-6"
      role="list"
      aria-labelledby="label-lavado"
    >
      {
        lavado.map((plan, i) => (
          <li
            data-reveal
            data-reveal-delay={
              String(Math.min(i + 1, 4)) as "1" | "2" | "3" | "4"
            }
          >
            <Card
              variant={plan.featured ? "featured" : "plain"}
              class="pricing-card relative flex h-full flex-col items-center gap-3 p-6 pt-8 text-center"
            >
              {"badge" in plan && plan.badge && (
                <span class="pricing-badge absolute left-1/2 -translate-x-1/2 whitespace-nowrap
                             rounded-pill bg-primary type-small font-semibold text-text-on-fill shadow-xs">
                  {plan.badge}
                </span>
              )}

              <p class="type-small font-semibold text-text-secondary">
                {plan.title}
              </p>

              <p class="type-h3 font-bold text-text">
                {plan.capacity}
              </p>

              <div class="flex items-center justify-center" aria-hidden="true">
                <LaundryBasket
                  size={Math.max(plan.iconSize + 24, 72)}
                  tone={
                    plan.color as
                      | "violet"
                      | "pink"
                      | "cyan"
                      | "orange"
                      | "mint"
                  }
                />
              </div>

              <p class="type-price text-text">
                {plan.price}
              </p>

              <p class="type-small text-muted flex-1">
                {plan.description}
              </p>

              <a
                href="#como-funciona"
                class="type-small mt-1 inline-flex min-h-[44px] items-center gap-1 font-semibold text-primary
                       transition-colors duration-[var(--duration-fast)]
                       hover:text-primary-hover
                       focus-visible:outline-none focus-visible:shadow-focus rounded-md px-1"
              >
                Ver detalle
                <span aria-hidden="true">→</span>
              </a>
            </Card>
          </li>
        ))
      }
    </ul>

    <ul
      id="pricing-panel-secado"
      class="pricing-panel pricing-panel--secado grid gap-8 pt-5 sm:grid-cols-2 lg:grid-cols-4 sm:gap-6"
      role="list"
      aria-labelledby="label-secado"
      hidden
    >
      {
        secado.map((plan, i) => (
          <li
            data-reveal
            data-reveal-delay={
              String(Math.min(i + 1, 4)) as "1" | "2" | "3" | "4"
            }
          >
            <Card
              variant={plan.featured ? "featured" : "plain"}
              class="pricing-card relative flex h-full flex-col items-center gap-3 p-6 pt-8 text-center"
            >
              {"badge" in plan && plan.badge && (
                <span class="pricing-badge absolute left-1/2 -translate-x-1/2 whitespace-nowrap
                             rounded-pill bg-primary type-small font-semibold text-text-on-fill shadow-xs">
                  {plan.badge}
                </span>
              )}

              <p class="type-small font-semibold text-text-secondary">
                {plan.title}
              </p>

              <p class="type-h3 font-bold text-text">
                {plan.capacity}
              </p>

              <div class="flex items-center justify-center" aria-hidden="true">
                <LaundryBasket
                  size={Math.max(plan.iconSize + 24, 72)}
                  tone={
                    plan.color as
                      | "violet"
                      | "pink"
                      | "cyan"
                      | "orange"
                      | "mint"
                  }
                />
              </div>

              <p class="type-price text-text">
                {plan.price}
              </p>

              <p class="type-small text-muted flex-1">
                {plan.description}
              </p>

              <a
                href="#como-funciona"
                class="type-small mt-1 inline-flex min-h-[44px] items-center gap-1 font-semibold text-primary
                       transition-colors duration-[var(--duration-fast)]
                       hover:text-primary-hover
                       focus-visible:outline-none focus-visible:shadow-focus rounded-md px-1"
              >
                Ver detalle
                <span aria-hidden="true">→</span>
              </a>
            </Card>
          </li>
        ))
      }
    </ul>

    <p class="type-small mt-8 text-center text-muted" data-reveal>
      {pricingIntro.note}
    </p>
  </div>
</section>

<style>
  .pricing-section {
    overflow: visible;
  }

  /* ── Atmósfera (SPEC-004) ─────────────────────────────────────────────── */
  .pricing-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
  }

  .pricing-atmosphere__wash {
    position: absolute;
    inset: 0;
    background: var(--gradient-wash);
  }

  .pricing-atmosphere__blob {
    position: absolute;
    border-radius: 60% 40% 55% 45% / 45% 55% 40% 60%;
    filter: blur(64px);
    opacity: 0.55;
  }

  .pricing-atmosphere__blob--tl {
    width: min(48vw, 28rem);
    height: min(40vw, 22rem);
    top: -12%;
    left: -8%;
    background: color-mix(
      in srgb,
      var(--color-primary-subtle) 80%,
      transparent
    );
  }

  .pricing-atmosphere__blob--br {
    width: min(52vw, 32rem);
    height: min(44vw, 24rem);
    bottom: -18%;
    right: -10%;
    background: color-mix(
      in srgb,
      var(--color-secondary-subtle) 75%,
      transparent
    );
  }

  .pricing-atmosphere__blob--tr {
    width: min(36vw, 20rem);
    height: min(30vw, 16rem);
    top: 18%;
    right: 8%;
    background: color-mix(
      in srgb,
      var(--color-accent-subtle) 70%,
      transparent
    );
    opacity: 0.45;
  }

  .pricing-atmosphere__bubbles {
    position: absolute;
    inset: 0;
    opacity: 0.08;
  }

  @media (min-width: 768px) {
    .pricing-atmosphere__bubbles {
      opacity: 0.1;
    }
  }

  @media (min-width: 1024px) {
    .pricing-atmosphere__bubbles {
      opacity: 0.12;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-atmosphere__blob {
      filter: blur(48px);
    }
  }

  .pricing-title-accent {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pricing-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pricing-tab-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-size: var(--text-button);
    font-weight: 600;
    line-height: var(--leading-button);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-soft),
      color var(--duration-fast) var(--ease-soft);
  }

  .pricing-tab-label:hover {
    color: var(--color-primary);
  }

  #pricing-tab-lavado:checked + .pricing-tab-label,
  #pricing-tab-secado:checked + .pricing-tab-label {
    background: var(--color-primary);
    color: var(--color-text-on-fill);
  }

  .pricing-tab-label:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .pricing-section:has(#pricing-tab-lavado:checked) .pricing-panel--lavado {
    display: grid;
  }
  .pricing-section:has(#pricing-tab-lavado:checked) .pricing-panel--secado {
    display: none !important;
  }
  .pricing-section:has(#pricing-tab-secado:checked) .pricing-panel--secado {
    display: grid !important;
  }
  .pricing-section:has(#pricing-tab-secado:checked) .pricing-panel--lavado {
    display: none;
  }

  .pricing-badge {
    top: -25px;
    padding: 0.8rem 2rem;
  }
</style>

<script>
  const lavadoTab = document.getElementById(
    "pricing-tab-lavado",
  ) as HTMLInputElement | null;
  const secadoTab = document.getElementById(
    "pricing-tab-secado",
  ) as HTMLInputElement | null;
  const panelLavado = document.getElementById("pricing-panel-lavado");
  const panelSecado = document.getElementById("pricing-panel-secado");

  function syncPanels() {
    const isLavado = lavadoTab?.checked ?? true;
    panelLavado?.toggleAttribute("hidden", !isLavado);
    panelSecado?.toggleAttribute("hidden", isLavado);
  }

  lavadoTab?.addEventListener("change", syncPanels);
  secadoTab?.addEventListener("change", syncPanels);
  syncPanels();
</script>
