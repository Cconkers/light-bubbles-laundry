---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <a href="#main-content" class="skip-link">Saltar al contenido</a>

  <main
    id="main-content"
    class="relative z-10 flex min-h-dvh flex-col items-center justify-center px-6 text-center"
  >
    <Image
      src={logo}
      alt="Logo de Burbujas de Luz"
      width={220}
      height={220}
      class="mb-6 w-40 drop-shadow-[0_8px_24px_rgba(2,136,209,0.35)] md:w-52"
      loading="eager"
      decoding="sync"
    />
    <p
      class="mb-3 text-sm font-medium uppercase tracking-widest text-caramel-gold-600"
    >
      Sevilla
    </p>
    <h1
      class="font-display text-4xl font-bold text-bubble-blue-600 md:text-6xl lg:text-7xl"
    >
      Burbujas de Luz
    </h1>
    <p
      class="mt-2 text-lg font-semibold uppercase tracking-wide text-slate-600"
    >
      Lavandería Autoservicio
    </p>
    <p class="mt-4 max-w-md text-lg text-slate-700">
      La fábrica de burbujas. Donde tu colada se convierte en magia.
    </p>
  </main>
</BaseLayout>
