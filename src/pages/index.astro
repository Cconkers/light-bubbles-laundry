---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <a href="#main-content" class="skip-link">Saltar al contenido</a>

  <main
    id="main-content"
    class="relative z-10 flex min-h-dvh flex-col items-center justify-center px-6 text-center"
  >
    <p class="mb-3 text-sm font-medium uppercase tracking-widest text-caramel-gold-600">
      Sevilla
    </p>
    <h1
      class="font-display text-4xl font-bold text-bubble-blue-600 md:text-6xl lg:text-7xl"
    >
      Light Bubbles Laundry
    </h1>
    <p class="mt-4 max-w-md text-lg text-slate-700">
      La fábrica de burbujas. Donde la colada se convierte en magia.
    </p>
    <p class="mt-8 text-sm text-slate-500">
      Canvas de fondo listo · Paso 1 completado
    </p>
  </main>
</BaseLayout>
