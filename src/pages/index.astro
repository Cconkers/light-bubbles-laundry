---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Benefits from '../components/sections/Benefits.astro';
import Services from '../components/sections/Services.astro';
import Pricing from '../components/sections/Pricing.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
import About from '../components/sections/About.astro';
import CtaFinal from '../components/sections/CtaFinal.astro';
import Location from '../components/sections/Location.astro';
import Footer from '../components/sections/Footer.astro';
import { site } from '../data/content';

const pageTitle = `${site.name} — ${site.tagline} en ${site.location}`;
const pageDescription =
  `Lavandería autoservicio en ${site.location}. Lava, seca y disfruta con máquinas modernas a tu ritmo. ` +
  `Consulta las tarifas, capacidades y horario.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage="/og-placeholder.webp"
>
  <!-- Skip link — primer elemento focusable (SPEC-001 Accesibilidad) -->
  <a href="#main-content" class="skip-link">Saltar al contenido</a>

  <!-- Header fijo -->
  <Header />

  <!-- Contenido principal -->
  <main id="main-content">
    <!-- 2. Hero — H1 + CTA primario visibles sin scroll en móvil -->
    <Hero />

    <!-- 3. Benefits -->
    <Benefits />

    <!-- 4. Services -->
    <Services />

    <!-- 5. Tarifas (SPEC-003) -->
    <Pricing />

    <!-- 6. How it works -->
    <HowItWorks />

    <!-- 7. FAQ / Preguntas (SPEC-007) -->
    <Faq />

    <!-- 8. Sobre nosotros (SPEC-008) -->
    <About />

    <!-- 9. CTA Final -->
    <CtaFinal />

    <!-- 10. Ubicación / Contacto (SPEC-006) -->
    <Location />
  </main>

  <!-- Footer -->
  <Footer />

  <!-- Scroll reveals — cargado diferido, sin bloquear el render (D-018) -->
  <script>
    import '../scripts/scroll-reveal';
  </script>
</BaseLayout>
